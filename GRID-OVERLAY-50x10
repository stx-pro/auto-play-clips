  // Create grid overlay
  const gridOverlay = document.getElementById("grid-overlay");
  const columns = 10;
  const rows = 50;

  function buildGrid() {
    gridOverlay.innerHTML = "";
    const overlayWidth = gridOverlay.clientWidth;
    const overlayHeight = gridOverlay.clientHeight;
    const colWidth = overlayWidth / columns;
    const rowHeight = overlayHeight / rows;

    for (let c = 0; c <= columns; c++) {
      const line = document.createElement("div");
      line.classList.add("line-vertical");
      line.style.left = c * colWidth + "px";
      gridOverlay.appendChild(line);

      if (c < columns) {
        const label = document.createElement("div");
        label.classList.add("label-col");
        label.style.left = c * colWidth + colWidth / 2 + "px";
        label.textContent = String.fromCharCode(65 + c);
        gridOverlay.appendChild(label);
      }
    }
    for (let r = 0; r <= rows; r++) {
      const line = document.createElement("div");
      line.classList.add("line-horizontal");
      line.style.top = r * rowHeight + "px";
      if (r % 10 === 0) line.classList.add("thick");
      gridOverlay.appendChild(line);

      if (r < rows) {
        const label = document.createElement("div");
        label.classList.add("label-row");
        label.style.top = r * rowHeight + rowHeight / 2 + "px";
        label.textContent = r + 1;
        gridOverlay.appendChild(label);
      }
    }
  }
  buildGrid();
  window.addEventListener("resize", buildGrid);

  // Toggle grid and sidebar
  toggleGridCheckbox.addEventListener("change", e => {
    const show = e.target.checked;
    gridOverlay.style.display = show ? "block" : "none";
    sidebar.style.display = show ? "flex" : "none";
    sidebar.setAttribute('aria-hidden', !show);
  });


